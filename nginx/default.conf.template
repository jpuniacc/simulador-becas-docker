server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location = /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # Proxy CRM (reemplazo de Netlify Function crm-proxy).
    # Host debe ser el del CRM upstream (CRM_PROXY_HOSTNAME), no el del simulador;
    # si se envía simuladordev/simulador.uniacc.cl el CRM responde 404.
    location = /api/crm-proxy {
        proxy_pass ${CRM_URL};
        proxy_http_version 1.1;
        proxy_set_header Host ${CRM_PROXY_HOSTNAME};
        proxy_set_header Content-Type $content_type;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
