# Build-time (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CRM_URL=http://crmadmision-qa.uniacc.cl/webservice/formulario_web.php
# Usado por proxy Vite en npm run dev (Host hacia el CRM)
VITE_CRM_PROXY_HOSTNAME=crmadmision-qa.uniacc.cl

# Runtime (nginx proxy CRM vía Traefik)
CRM_URL=http://crmadmision-qa.uniacc.cl/webservice/formulario_web.php
# Host HTTP enviado al CRM (hostname del upstream, no el del simulador)
CRM_PROXY_HOSTNAME=crmadmision-qa.uniacc.cl
